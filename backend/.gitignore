```gitignore
# =========================
# Environment & Secrets
# =========================

.env
.env.local
.env.*.local
!.env.example


# =========================
# Dependencies
# =========================

node_modules/


# =========================
# Build Output
# =========================

dist/
build/
.next/
.nuxt/


# =========================
# Logs
# =========================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =========================
# Coverage / Testing
# =========================

coverage/
*.lcov


# =========================
# Operating System
# =========================

.DS_Store
Thumbs.db


# =========================
# IDE / Editor
# =========================

.vscode/
.idea/


# =========================
# Cache
# =========================

.cache/
.parcel-cache/
.vite/


# =========================
# Local Databases
# =========================

*.sqlite
*.sqlite3
*.db


# =========================
# Temporary Files
# =========================

*.tmp
*.temp
*.swp
*.swo


# =========================
# Uploads / Generated Files
# =========================

uploads/
tmp/
temp/
```
